ash. The installer is not code-signed, so Windows SmartScreen shows \"Windows protected your PC\": click **More info**, then **Run anyway**.\n\nDoodlebay is built on the open-source Excalidraw editor and is not made by or connected to the Excalidraw team.\n"},{"url":"https://api.github.com/repos/ZazaGdev/Doodlebay/releases/404077072","assets_url":"https://api.github.com/repos/ZazaGdev/Doodlebay/releases/404077072/assets","upload_url":"https://uploads.github.com/repos/ZazaGdev/Doodlebay/releases/404077072/assets{?name,label}","html_url":"https://github.com/ZazaGdev/Doodlebay/releases/tag/v0.3.1","id":404077072,"author":{"login":"ZazaGdev","id":75507663,"node_id":"MDQ6VXNlcjc1NTA3NjYz","avatar_url":"https://avatars.githubusercontent.com/u/75507663?v=4","gravatar_id":"","url":"https://api.github.com/users/ZazaGdev","html_url":"https://github.com/ZazaGdev","followers_url":"https://api.github.com/users/ZazaGdev/followers","following_url":"https://api.github.com/users/ZazaGdev/following{/other_user}","gists_url":"https://api.github.com/users/ZazaGdev/gists{/gist_id}","starred_url":"https://api.github.com/users/ZazaGdev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ZazaGdev/subscriptions","organizations_url":"https://api.github.com/users/ZazaGdev/orgs","repos_url":"https://api.github.com/users/ZazaGdev/repos","events_url":"https://api.github.com/users/ZazaGdev/events{/privacy}","received_events_url":"https://api.github.com/users/ZazaGdev/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOU8yamc4YFboQ","tag_name":"v0.3.1","target_commitish":"main","name":"Doodlebay 0.3.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-05T20:31:06Z","updated_at":"2026-10-05T20:31:13Z","published_at":"2026-10-05T20:31:13Z","assets":[{"url":"https://api.github.com/repos/ZazaGdev/Doodlebay/releases/assets/613564768","id":613564768,"node_id":"RA_kwDOU8yamc4kkkFg","name":"Doodlebay-Setup-0.3.1.exe","